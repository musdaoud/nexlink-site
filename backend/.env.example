# ============================================================================
# HyperLink backend — configuration. Copy to `.env` and fill in.
# NEVER commit `.env` (it holds passwords).
# Keep comments on their own lines: Docker reads "KEY=  # text" as the value "# text".
# ============================================================================

# --- Django --------------------------------------------------------------------
# 0 in production
DJANGO_DEBUG=1
# production: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# production: api.yourdomain.dz
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# production: https://api.yourdomain.dz
DJANGO_CSRF_TRUSTED_ORIGINS=
# admin address — keep it non-obvious in production
ADMIN_URL=gestion/
# production: 1, then run `python manage.py setup_2fa <username>`
ADMIN_REQUIRE_2FA=0

# --- Database ------------------------------------------------------------------
POSTGRES_DB=hyperlink
POSTGRES_USER=hyperlink
# production: a long random password
POSTGRES_PASSWORD=hyperlink-dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Website allowed to post the form (exact origins, comma separated) ----------
# production: https://www.yourdomain.dz,https://yourdomain.dz
CORS_ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# --- Email (SMTP) --------------------------------------------------------------
# Development: Mailpit catches every email → http://localhost:8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HyperLink <no-reply@hyperlink.local>

# Real sending with Gmail (needs 2-step verification + an "App password").
# Gmail requires DEFAULT_FROM_EMAIL to be the Gmail account itself.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=HyperLink <you@gmail.com>

# --- Contact form --------------------------------------------------------------
# who receives new requests (comma separated)
CONTACT_NOTIFY_TO=you@example.com
# address visitors reply to (empty = first CONTACT_NOTIFY_TO)
CONTACT_REPLY_TO=
# attach the visitor's file to the notification email
CONTACT_ATTACH_FILES=1
# `python manage.py purge_contact_requests` deletes requests older than this
CONTACT_RETENTION_DAYS=365
# max submissions per IP
CONTACT_RATE=5/10m
CONTACT_MAX_UPLOAD_MB=10
# used for the "open request" link in emails
SITE_ADMIN_BASE_URL=http://localhost:8010
# optional Cloudflare Turnstile secret key (leave empty to disable)
TURNSTILE_SECRET=

# --- Production only -------------------------------------------------------------
# Caddy gets the HTTPS certificate for this name
# API_DOMAIN=api.yourdomain.dz
# real client IP behind Caddy
# RATELIMIT_IP_META_KEY=HTTP_X_FORWARDED_FOR
